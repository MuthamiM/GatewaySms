# Server Configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Redis Connection (For Message Queue & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SMS Gateway Integration
# Mode: "mock" (for instant local testing without phone) or "smsgate" (live Android SMS Gate private server)
GATEWAY_MODE=mock

# SMS Gateway for Android Private Server Config (Used when GATEWAY_MODE=smsgate)
SMSGATE_SERVER_URL=http://localhost:3000
SMSGATE_PRIVATE_TOKEN=secret_gateway_token_2026
SMSGATE_API_USER=
SMSGATE_API_PASSWORD=

# SaaS Pacing & Safeguards
MAX_SMS_PER_SIM_PER_MINUTE=20
